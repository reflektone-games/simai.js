{
    "name": "simai.js",
    "version": "1.1.4",
    "description": "A serializer/deserializer for the rhythm game chart format simai.",
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "type": "commonjs",
    "types": "dist/index.d.ts",
    "runkitExampleFilename": "examples/runkit.js",
    "exports": {
        "import": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        },
        "require": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.cjs"
        }
    },
    "scripts": {
        "test": "mocha",
        "build": "rimraf dist && tsdown",
        "prepack": "pnpm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/reflektone-games/simai.js.git"
    },
    "keywords": [
        "serializer",
        "deserializer",
        "data-format",
        "maimai",
        "maimai-dx"
    ],
    "author": "reflektone-games",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/reflektone-games/simai.js/issues"
    },
    "homepage": "https://github.com/reflektone-games/simai.js#readme",
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^24",
        "mocha": "^11.8.0",
        "rimraf": "^6.1.3",
        "tsdown": "^0.22.14",
        "tsx": "^4.23.8",
        "typescript": "^7.0.2"
    },
    "packageManager": "pnpm@11.20.0"
}
